# Credentials for the NMDC Runtime API site client used by --mint-real-ids.
# Obtain these from the NMDC team. Never commit real values.
NMDC_RUNTIME_CLIENT_ID=
NMDC_RUNTIME_CLIENT_SECRET=

# Optional: which runtime API instance to talk to ("prod" by default; "dev" for staging).
# NMDC_RUNTIME_ENV=prod

# Optional: ontology-term QC (linkml-term-validator). Only ENVO is checked by default.
# Comma-separated PREFIX=adapter pairs add/override OAK adapters, e.g. to check NCBITaxon terms
# (sqlite:obo:ncbitaxon is a multi-GB one-time download; ols:ncbitaxon is one request per taxon).
# NMDC_TERM_VALIDATION_ADAPTERS=NCBITaxon=sqlite:obo:ncbitaxon
# Where the validator caches labels / anchor closures (default: ~/.cache/nmdc-ingest-agent/term-validator).
# NMDC_TERM_VALIDATION_CACHE_DIR=
